# Copie para .env e ajuste. O .env não vai para o Git.

# Senha dos dois PostgreSQL locais
POSTGRES_PASSWORD=troque-esta-senha

# Chave mestra do auth-service (protege POST /admin/keys)
MASTER_KEY=troque-esta-chave-mestra

# Chave que o evaluation-service usa para chamar flag-service e targeting-service.
# É cadastrada automaticamente no banco do auth-service na primeira subida.
# Gere uma com:  echo "tm_key_$(openssl rand -hex 32)"
SERVICE_API_KEY=tm_key_troque_esta_chave
